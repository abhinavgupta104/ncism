<title>NCISM Homepage Concept</title>
<style>/*__FONTS__*/</style>
<style>
/* ===================== TOKENS ===================== */
:root{
  --paper:#F3F6F1;
  --surface:#FFFFFF;
  --surface-2:#E9EEE6;
  --surface-3:#DFE6DC;
  --ink:#141F1A;
  --ink-2:#37453E;
  --muted:#6B7871;
  --rule:#D3DCD1;
  --rule-2:#B6C3B4;

  --teal:#0F5A4F;
  --teal-hi:#17796B;
  --teal-soft:#E0EFEA;
  /* constant in both themes: surfaces that always carry white text */
  --teal-deep:#0F5A4F;
  --orange-deep:#B4560A;
  --gold:#9A7412;
  --gold-pure:#DEAC2F;
  --gold-soft:#F7EBD4;
  --leaf:#4C7C17;
  --leaf-soft:#E7F1D9;
  --orange:#C2620A;
  --orange-soft:#FBE9D5;
  --red:#9E3119;
  --red-soft:#F7E3DE;

  --on-accent:#FFFFFF;
  --strip:#10201B;
  --strip-ink:#C9D6CE;

  --shadow-1:0 1px 2px rgba(20,31,26,.05), 0 6px 18px -10px rgba(20,31,26,.16);
  --shadow-2:0 2px 4px rgba(20,31,26,.06), 0 18px 40px -20px rgba(20,31,26,.28);

  --display:"Spectral",Georgia,"Times New Roman",serif;
  --body:"Public Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  --deva:"Tiro Devanagari Sanskrit",Georgia,serif;
  --mono:ui-monospace,"Cascadia Mono",Consolas,"DejaVu Sans Mono",monospace;

  --maxw:78rem;
  --pad:clamp(1.1rem,4vw,3rem);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#0D1512;
    --surface:#141D19;
    --surface-2:#1A2520;
    --surface-3:#22302A;
    --ink:#E8ECE7;
    --ink-2:#BEC8C1;
    --muted:#8B9891;
    --rule:#27332D;
    --rule-2:#3A4740;
    --teal:#54B7A1;
    --teal-hi:#7FCFBB;
    --teal-soft:#102C26;
    --gold:#DDAC4A;
    --gold-pure:#DEAC2F;
    --gold-soft:#2E2410;
    --leaf:#8FBE45;
    --leaf-soft:#1C2A11;
    --orange:#E39352;
    --orange-soft:#2F1F10;
    --red:#E08063;
    --red-soft:#301810;
    --on-accent:#08110E;
    --strip:#081210;
    --strip-ink:#A9BAB1;
    --shadow-1:0 1px 2px rgba(0,0,0,.4), 0 6px 18px -10px rgba(0,0,0,.6);
    --shadow-2:0 2px 4px rgba(0,0,0,.5), 0 18px 40px -20px rgba(0,0,0,.75);
  }
}
:root[data-theme="dark"]{
  --paper:#0D1512;
  --surface:#141D19;
  --surface-2:#1A2520;
  --surface-3:#22302A;
  --ink:#E8ECE7;
  --ink-2:#BEC8C1;
  --muted:#8B9891;
  --rule:#27332D;
  --rule-2:#3A4740;
  --teal:#54B7A1;
  --teal-hi:#7FCFBB;
  --teal-soft:#102C26;
  --gold:#DDAC4A;
  --gold-pure:#DEAC2F;
  --gold-soft:#2E2410;
  --leaf:#8FBE45;
  --leaf-soft:#1C2A11;
  --orange:#E39352;
  --orange-soft:#2F1F10;
  --red:#E08063;
  --red-soft:#301810;
  --on-accent:#08110E;
  --strip:#081210;
  --strip-ink:#A9BAB1;
  --shadow-1:0 1px 2px rgba(0,0,0,.4), 0 6px 18px -10px rgba(0,0,0,.6);
  --shadow-2:0 2px 4px rgba(0,0,0,.5), 0 18px 40px -20px rgba(0,0,0,.75);
}

/* ===================== BASE ===================== */
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--body);font-size:16.5px;line-height:1.6;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
}
.wrap{max-width:var(--maxw);margin:0 auto;padding-inline:var(--pad)}
h1,h2,h3{font-family:var(--display);font-weight:700;line-height:1.16;margin:0;text-wrap:balance;letter-spacing:-.015em}
h4,h5{font-family:var(--body);font-weight:600;margin:0;line-height:1.3}
p{margin:0}
img,svg{max-width:100%}
a{color:inherit}
:focus-visible{outline:2.5px solid var(--teal-hi);outline-offset:3px;border-radius:3px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{
  position:absolute;left:.6rem;top:-4rem;z-index:99;background:var(--teal);color:var(--on-accent);
  padding:.6rem 1rem;border-radius:0 0 4px 4px;font-weight:600;font-size:.9rem;text-decoration:none;
  transition:top .18s ease;
}
.skip:focus{top:0}
.eyebrow{
  font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);
}
.num{font-variant-numeric:tabular-nums}

/* ===================== CONCEPT BANNER ===================== */
.concept{
  background:repeating-linear-gradient(135deg,var(--gold-soft),var(--gold-soft) 10px,transparent 10px,transparent 20px);
  border-bottom:1px solid var(--rule);
}
.concept .wrap{
  display:flex;gap:.6rem;align-items:center;justify-content:center;flex-wrap:wrap;
  padding-block:.42rem;font-size:.76rem;color:var(--ink-2);text-align:center;
}
.concept b{color:var(--ink);font-weight:600}

/* ===================== GOV STRIP ===================== */
.gov{background:var(--strip);color:var(--strip-ink);font-size:.78rem}
.gov .wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:.42rem;flex-wrap:wrap}
.gov-left{display:flex;align-items:center;gap:.55rem}
.gov-left svg{flex:none}
.gov-tools{display:flex;align-items:center;gap:.3rem;flex-wrap:wrap}
.gov-tools .sep{width:1px;height:1rem;background:rgba(255,255,255,.18);margin-inline:.35rem}
.tool{
  background:transparent;border:1px solid rgba(255,255,255,.22);color:inherit;
  font-family:var(--body);font-size:.74rem;line-height:1;padding:.28rem .5rem;border-radius:3px;cursor:pointer;
  transition:background .16s ease,border-color .16s ease;
}
.tool:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.45)}
.tool[aria-pressed="true"]{background:var(--gold-pure);border-color:var(--gold-pure);color:#241a04;font-weight:600}
.tool.lang{display:flex;align-items:center;gap:.3rem}

/* ===================== HEADER ===================== */
.masthead{background:var(--surface);border-bottom:1px solid var(--rule)}
.masthead .wrap{display:flex;align-items:center;gap:1.5rem;justify-content:space-between;padding-block:.85rem;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:.85rem;text-decoration:none;min-width:0}
.brand-mark{flex:none}
.brand-txt{min-width:0}
.brand-txt strong{
  display:block;font-family:var(--display);font-weight:700;font-size:1.06rem;letter-spacing:-.01em;line-height:1.2;
}
.brand-txt span{display:block;font-size:.73rem;color:var(--muted);letter-spacing:.02em;margin-top:.1rem}
.brand-txt .hi{font-family:var(--deva);font-size:.82rem;color:var(--ink-2)}
.mast-right{display:flex;align-items:center;gap:.75rem}
.search{display:flex;align-items:center;background:var(--surface-2);border:1px solid var(--rule);border-radius:4px;overflow:hidden}
.search:focus-within{border-color:var(--teal-hi);box-shadow:0 0 0 3px var(--teal-soft)}
.search input{
  border:0;background:transparent;color:var(--ink);font-family:var(--body);font-size:.88rem;
  padding:.5rem .7rem;width:min(15rem,38vw);
}
.search input:focus{outline:none}
.search input::placeholder{color:var(--muted)}
.search button{
  border:0;background:var(--teal);color:var(--on-accent);padding:.55rem .75rem;cursor:pointer;display:grid;place-items:center;
  transition:background .16s ease;
}
.search button:hover{background:var(--teal-hi)}
.emblems{display:flex;align-items:center;gap:.7rem}
.emblems img{height:2.4rem;width:auto;border-radius:2px}
@media (max-width:900px){ .emblems{display:none} }

/* ===================== NAV ===================== */
.nav{background:var(--teal-deep);position:sticky;top:0;z-index:40;box-shadow:var(--shadow-1)}
.nav .wrap{display:flex;align-items:stretch;gap:0;flex-wrap:wrap}
.nav-toggle{display:none}
.nav-list{display:flex;list-style:none;margin:0;padding:0;flex-wrap:wrap;flex:1}
.nav-list>li{position:relative}
.nav-btn{
  background:transparent;border:0;color:#EAF3F0;font-family:var(--body);font-size:.87rem;font-weight:500;
  padding:.78rem .95rem;cursor:pointer;display:flex;align-items:center;gap:.35rem;
  border-bottom:2.5px solid transparent;transition:background .16s ease,border-color .2s ease,color .16s ease;
}
.nav-btn:hover,.nav-list>li.open .nav-btn{background:rgba(255,255,255,.1);color:#fff;border-bottom-color:var(--gold-pure)}
.nav-btn .chev{font-size:.6rem;transition:transform .24s ease;opacity:.8}
.nav-list>li.open .nav-btn .chev{transform:rotate(180deg)}
.panel{
  position:absolute;top:100%;left:0;min-width:15rem;background:var(--surface);
  border:1px solid var(--rule);border-top:2.5px solid var(--gold-pure);border-radius:0 0 4px 4px;
  box-shadow:var(--shadow-2);padding:.4rem;z-index:5;
  opacity:0;transform:translateY(-8px);pointer-events:none;
  transition:opacity .2s ease,transform .24s cubic-bezier(.22,.61,.36,1);
}
.nav-list>li.open .panel{opacity:1;transform:translateY(0);pointer-events:auto}
.panel a{
  display:block;padding:.42rem .65rem;font-size:.86rem;color:var(--ink-2);text-decoration:none;border-radius:3px;
  opacity:0;transform:translateX(-6px);
}
.nav-list>li.open .panel a{animation:navin .28s cubic-bezier(.22,.61,.36,1) forwards}
.nav-list>li.open .panel a:nth-child(1){animation-delay:.03s}
.nav-list>li.open .panel a:nth-child(2){animation-delay:.06s}
.nav-list>li.open .panel a:nth-child(3){animation-delay:.09s}
.nav-list>li.open .panel a:nth-child(4){animation-delay:.12s}
.nav-list>li.open .panel a:nth-child(5){animation-delay:.15s}
.nav-list>li.open .panel a:nth-child(6){animation-delay:.18s}
.panel a:hover{background:var(--teal-soft);color:var(--teal-hi)}
@keyframes navin{to{opacity:1;transform:translateX(0)}}
@media (max-width:820px){
  .nav .wrap{padding-block:.3rem}
  .nav-toggle{
    display:flex;align-items:center;gap:.5rem;background:transparent;border:1px solid rgba(255,255,255,.3);
    color:#fff;font-family:var(--body);font-size:.85rem;padding:.45rem .8rem;border-radius:3px;cursor:pointer;margin:.3rem 0;
  }
  .nav-list{display:none;width:100%;flex-direction:column;padding-bottom:.5rem}
  .nav.open .nav-list{display:flex}
  .panel{position:static;opacity:1;transform:none;pointer-events:auto;display:none;box-shadow:none;border-top-width:1px;margin:0 0 .3rem .8rem}
  .nav-list>li.open .panel{display:block}
  .nav-list>li.open .panel a{animation:none;opacity:1;transform:none}
  .nav-btn{width:100%;justify-content:space-between}
}

/* ===================== HERO ===================== */
.hero{position:relative;overflow:hidden;background:var(--surface);border-bottom:1px solid var(--rule)}
.hero::before{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(58rem 30rem at 88% 18%, rgba(72,172,146,.16), transparent 62%),
    radial-gradient(45rem 26rem at 4% 88%, rgba(222,172,47,.14), transparent 60%);
}
.hero .wrap{
  position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.75fr);
  gap:clamp(1.5rem,4vw,3.5rem);align-items:center;padding-block:clamp(2.4rem,6vw,4.6rem);
}
@media (max-width:900px){ .hero .wrap{grid-template-columns:1fr;text-align:left} .hero-art{order:-1;max-width:17rem;margin-inline:auto} }
.hero h1{font-size:clamp(1.95rem,4.6vw,3.15rem);margin-block:.6rem .1rem}
.hero .motto{
  font-family:var(--deva);font-size:clamp(1.5rem,3.6vw,2.3rem);line-height:1.75;margin-top:.55rem;
  background:linear-gradient(95deg,#B26412 0%,#DEAC2F 32%,#48AC92 68%,#3FA832 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  width:fit-content;
}
.hero .motto-en{font-style:italic;color:var(--muted);font-size:.95rem;margin-top:.1rem}
.hero .lede{color:var(--ink-2);font-size:1.03rem;max-width:44ch;margin-top:1.05rem}
.cta-row{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.5rem}
.btn{
  display:inline-flex;align-items:center;gap:.5rem;font-family:var(--body);font-size:.9rem;font-weight:600;
  padding:.68rem 1.15rem;border-radius:4px;text-decoration:none;cursor:pointer;border:1px solid transparent;
  transition:transform .2s cubic-bezier(.22,.61,.36,1),background .18s ease,box-shadow .2s ease,border-color .18s ease;
}
.btn svg{flex:none;transition:transform .24s cubic-bezier(.22,.61,.36,1)}
.btn-primary{background:var(--teal);color:var(--on-accent)}
.btn-primary:hover{background:var(--teal-hi);transform:translateY(-2px);box-shadow:0 10px 22px -12px rgba(15,90,79,.8)}
.btn-primary:hover svg{transform:translateX(3px)}
.btn-ghost{background:transparent;color:var(--ink);border-color:var(--rule-2)}
.btn-ghost:hover{border-color:var(--teal);color:var(--teal-hi);background:var(--teal-soft);transform:translateY(-2px)}
.hero-art{display:flex;justify-content:center}
.hero-art svg{width:100%;max-width:20rem;height:auto}

/* logo stroke draw */
.lf{fill:none;stroke-width:9;stroke-linecap:round;stroke-dasharray:560;stroke-dashoffset:560;animation:draw 1.6s cubic-bezier(.22,.61,.36,1) forwards}
.lf:nth-of-type(1){animation-delay:.1s}
.lf:nth-of-type(2){animation-delay:.26s}
.lf:nth-of-type(3){animation-delay:.42s}
.lf:nth-of-type(4){animation-delay:.58s}
.arc{fill:none;stroke-width:11;stroke-linecap:round;stroke-dasharray:150;stroke-dashoffset:150;animation:draw 1s ease-out .9s forwards}
.fig{opacity:0;animation:pop .55s cubic-bezier(.2,1.5,.4,1) 1.2s forwards;transform-origin:150px 180px}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes pop{from{opacity:0;transform:scale(.55)}to{opacity:1;transform:scale(1)}}

/* ===================== TICKER ===================== */
.ticker{display:flex;background:var(--surface-2);border-bottom:1px solid var(--rule);align-items:stretch}
.ticker-tag{
  background:var(--orange-deep);color:#fff;font-family:var(--mono);font-size:.63rem;letter-spacing:.13em;
  text-transform:uppercase;display:grid;place-items:center;padding:.6rem .85rem;white-space:nowrap;flex:none;
}
.ticker-view{
  overflow:hidden;flex:1;display:flex;align-items:center;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 2%,#000 94%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 2%,#000 94%,transparent);
}
.ticker-track{display:flex;gap:2.6rem;width:max-content;animation:slide 46s linear infinite;padding-left:1rem}
.ticker:hover .ticker-track,.ticker:focus-within .ticker-track{animation-play-state:paused}
.ticker-track a{font-size:.82rem;color:var(--ink-2);white-space:nowrap;text-decoration:none;padding-block:.55rem}
.ticker-track a:hover{color:var(--teal-hi);text-decoration:underline}
.ticker-track a::before{content:"◆";color:var(--gold-pure);font-size:.5rem;vertical-align:middle;margin-right:.55rem}
@keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.ticker-pause{
  border:0;border-left:1px solid var(--rule);background:var(--surface-2);color:var(--muted);
  padding:0 .8rem;cursor:pointer;font-size:.7rem;font-family:var(--mono);flex:none;
}
.ticker-pause:hover{color:var(--ink);background:var(--surface-3)}

/* ===================== SECTIONS ===================== */
section{padding-block:clamp(2.6rem,6vw,4.4rem)}
.sec-head{margin-bottom:1.7rem;max-width:60ch}
.sec-head h2{font-size:clamp(1.45rem,3vw,2.05rem);margin-block:.45rem .5rem}
.sec-head p{color:var(--ink-2);font-size:.98rem}
.alt{background:var(--surface);border-block:1px solid var(--rule)}

/* reveal - only hides when JS is present, so content never gets stranded */
.js .rv{opacity:0;transform:translateY(16px)}
.js .rv.in{animation:rise .62s cubic-bezier(.22,.61,.36,1) forwards}
.js .rv.in:nth-child(2){animation-delay:.07s}
.js .rv.in:nth-child(3){animation-delay:.14s}
.js .rv.in:nth-child(4){animation-delay:.21s}
@keyframes rise{to{opacity:1;transform:translateY(0)}}

/* ===================== TASK CARDS ===================== */
.tasks{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:.85rem}
.task{
  background:var(--surface);border:1px solid var(--rule);border-radius:5px;padding:1.35rem 1.4rem;
  text-decoration:none;display:flex;flex-direction:column;gap:.4rem;box-shadow:var(--shadow-1);position:relative;overflow:hidden;
  transition:transform .28s cubic-bezier(.22,.61,.36,1),box-shadow .28s ease,border-color .28s ease;
}
.task::after{
  content:"";position:absolute;left:0;right:0;bottom:0;height:2.5px;background:var(--tc,var(--teal));
  transform:scaleX(0);transform-origin:left;transition:transform .34s cubic-bezier(.22,.61,.36,1);
}
.task:hover{transform:translateY(-5px);border-color:var(--rule-2);box-shadow:var(--shadow-2)}
.task:hover::after{transform:scaleX(1)}
.task-ico{
  width:2.5rem;height:2.5rem;border-radius:5px;display:grid;place-items:center;margin-bottom:.35rem;
  background:var(--tcs,var(--teal-soft));color:var(--tc,var(--teal));
  transition:transform .3s cubic-bezier(.2,1.4,.4,1);
}
.task:hover .task-ico{transform:rotate(-7deg) scale(1.07)}
.task h4{font-size:1rem}
.task p{font-size:.88rem;color:var(--muted)}
.task .go{
  margin-top:auto;padding-top:.6rem;font-size:.8rem;font-weight:600;color:var(--tc,var(--teal));
  display:flex;align-items:center;gap:.35rem;
}
.task:hover .go svg{transform:translateX(4px)}
.task .go svg{transition:transform .26s cubic-bezier(.22,.61,.36,1)}

/* ===================== NOTICES ===================== */
.notice-wrap{display:grid;grid-template-columns:minmax(0,1fr) 19rem;gap:1.2rem;align-items:start}
@media (max-width:900px){ .notice-wrap{grid-template-columns:1fr} }
.tabs{display:flex;gap:.25rem;border-bottom:1px solid var(--rule);margin-bottom:.2rem;overflow-x:auto}
.tab{
  background:transparent;border:0;border-bottom:2.5px solid transparent;color:var(--muted);
  font-family:var(--body);font-size:.87rem;font-weight:600;padding:.6rem .85rem;cursor:pointer;white-space:nowrap;
  transition:color .18s ease,border-color .22s ease;
}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{color:var(--teal-hi);border-bottom-color:var(--teal)}
.notice-list{list-style:none;margin:0;padding:0}
.notice-list li{border-bottom:1px solid var(--rule)}
.notice-list a{
  display:grid;grid-template-columns:5.6rem minmax(0,1fr) auto;gap:.9rem;align-items:baseline;
  padding:.72rem .3rem;text-decoration:none;transition:background .18s ease;
}
.notice-list a:hover{background:var(--surface-2)}
.notice-list a:hover .nt{color:var(--teal-hi)}
.nd{font-family:var(--mono);font-size:.72rem;color:var(--muted);white-space:nowrap}
.nt{font-size:.9rem;color:var(--ink-2);transition:color .18s ease}
.chip{
  font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;
  padding:.16rem .45rem;border-radius:999px;white-space:nowrap;border:1px solid currentColor;
}
.chip.new{color:var(--orange);background:var(--orange-soft)}
.chip.pdf{color:var(--muted);background:var(--surface-2)}
.chip.ok{color:var(--leaf);background:var(--leaf-soft)}
@media (max-width:560px){
  .notice-list a{grid-template-columns:1fr auto;gap:.2rem .6rem}
  .nd{grid-column:1/-1}
}
.aside-card{background:var(--surface);border:1px solid var(--rule);border-radius:5px;padding:1.15rem 1.25rem;box-shadow:var(--shadow-1)}
.aside-card + .aside-card{margin-top:.85rem}
.aside-card h4{font-size:.95rem;margin-bottom:.7rem;display:flex;align-items:center;gap:.5rem}
.aside-card h4 svg{color:var(--teal)}
.board-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.5rem}
.board-list a{
  display:flex;justify-content:space-between;gap:.6rem;align-items:center;text-decoration:none;
  font-size:.86rem;color:var(--ink-2);padding:.35rem .1rem;border-bottom:1px dashed var(--rule);
}
.board-list a:last-child{border-bottom:0}
.board-list a:hover{color:var(--teal-hi)}
.board-list .ab{font-family:var(--mono);font-size:.68rem;color:var(--muted)}

/* ===================== SYSTEMS ===================== */
.systems{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:.85rem}
.sys{
  position:relative;background:var(--surface);border:1px solid var(--rule);border-radius:5px;overflow:hidden;
  text-decoration:none;display:flex;flex-direction:column;box-shadow:var(--shadow-1);
  transition:transform .3s cubic-bezier(.22,.61,.36,1),box-shadow .3s ease;
}
.sys:hover{transform:translateY(-6px);box-shadow:var(--shadow-2)}
.sys-top{height:5.5rem;position:relative;background:var(--sg,linear-gradient(135deg,#17796B,#48AC92));display:grid;place-items:center;overflow:hidden}
.sys-top::after{
  content:"";position:absolute;inset:0;background:radial-gradient(12rem 6rem at 50% 130%,rgba(255,255,255,.4),transparent 70%);
}
.sys-glyph{
  font-family:var(--deva);font-size:2.5rem;color:rgba(255,255,255,.95);line-height:1;position:relative;z-index:1;
  text-shadow:0 2px 10px rgba(0,0,0,.2);transition:transform .34s cubic-bezier(.2,1.35,.4,1);
}
.sys:hover .sys-glyph{transform:scale(1.1) rotate(-4deg)}
.sys-body{padding:1rem 1.15rem 1.15rem;display:flex;flex-direction:column;gap:.3rem;flex:1}
.sys-body h4{font-family:var(--display);font-size:1.12rem;font-weight:700}
.sys-body p{font-size:.85rem;color:var(--muted);flex:1}
.sys-meta{display:flex;gap:.8rem;margin-top:.6rem;padding-top:.6rem;border-top:1px solid var(--rule)}
.sys-meta span{font-family:var(--mono);font-size:.68rem;color:var(--muted)}
.sys-meta b{color:var(--ink);font-weight:600}

/* ===================== COLLEGE FINDER ===================== */
.finder{background:var(--surface);border:1px solid var(--rule);border-radius:6px;box-shadow:var(--shadow-1);overflow:hidden}
.finder-bar{display:flex;gap:.6rem;padding:.9rem 1rem;border-bottom:1px solid var(--rule);flex-wrap:wrap;align-items:center;background:var(--surface-2)}
.finder-bar input,.finder-bar select{
  font-family:var(--body);font-size:.86rem;padding:.48rem .6rem;border:1px solid var(--rule-2);border-radius:4px;
  background:var(--surface);color:var(--ink);
}
.finder-bar input{flex:1;min-width:11rem}
.finder-bar input:focus,.finder-bar select:focus{outline:none;border-color:var(--teal-hi);box-shadow:0 0 0 3px var(--teal-soft)}
.finder-count{font-family:var(--mono);font-size:.72rem;color:var(--muted);margin-left:auto}
.tbl-scroll{overflow-x:auto;max-height:23rem;overflow-y:auto}
table.colleges{width:100%;border-collapse:collapse;font-size:.87rem;min-width:40rem}
table.colleges th{
  position:sticky;top:0;background:var(--surface);z-index:1;
  font-family:var(--mono);font-size:.63rem;letter-spacing:.11em;text-transform:uppercase;color:var(--muted);
  font-weight:500;text-align:left;padding:.6rem .9rem;border-bottom:1px solid var(--rule-2);
}
table.colleges td{padding:.6rem .9rem;border-bottom:1px solid var(--rule);vertical-align:middle}
table.colleges tbody tr{transition:background .16s ease}
table.colleges tbody tr:hover{background:var(--surface-2)}
table.colleges td:first-child{font-weight:600;color:var(--ink)}
.st{
  display:inline-flex;align-items:center;gap:.35rem;font-size:.74rem;font-weight:600;
  padding:.2rem .55rem;border-radius:999px;white-space:nowrap;
}
.st::before{content:"";width:.42rem;height:.42rem;border-radius:50%;background:currentColor}
.st.permitted{color:var(--leaf);background:var(--leaf-soft)}
.st.conditional{color:var(--orange);background:var(--orange-soft)}
.st.denied{color:var(--red);background:var(--red-soft)}
.tbl-empty{padding:2rem 1rem;text-align:center;color:var(--muted);font-size:.88rem}
.demo-note{
  display:flex;gap:.5rem;align-items:center;padding:.55rem 1rem;background:var(--gold-soft);
  border-top:1px solid var(--rule);font-size:.76rem;color:var(--ink-2);
}

/* ===================== STATS ===================== */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:6px;overflow:hidden}
.stat{background:var(--surface);padding:1.5rem 1.2rem;text-align:center}
.stat .v{font-family:var(--display);font-size:clamp(1.9rem,4vw,2.7rem);font-weight:700;color:var(--teal-hi);font-variant-numeric:tabular-nums;line-height:1}
.stat .k{font-size:.82rem;color:var(--muted);margin-top:.4rem}
.stat .v .suf{font-size:.6em}

/* ===================== FOOTER ===================== */
footer{background:var(--strip);color:var(--strip-ink);padding-block:2.8rem 0;margin-top:0}
.fgrid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:2rem;padding-bottom:2rem}
@media (max-width:820px){ .fgrid{grid-template-columns:1fr 1fr;gap:1.5rem} }
@media (max-width:520px){ .fgrid{grid-template-columns:1fr} }
.fgrid h5{
  font-family:var(--mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;
  color:#7E9187;margin-bottom:.85rem;font-weight:500;
}
.fgrid ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.45rem}
.fgrid a{font-size:.86rem;text-decoration:none;color:var(--strip-ink);transition:color .16s ease;width:fit-content;position:relative}
.fgrid a::after{
  content:"";position:absolute;left:0;bottom:-2px;height:1px;width:100%;background:var(--gold-pure);
  transform:scaleX(0);transform-origin:right;transition:transform .3s cubic-bezier(.22,.61,.36,1);
}
.fgrid a:hover{color:#fff}
.fgrid a:hover::after{transform:scaleX(1);transform-origin:left}
.faddr{font-size:.86rem;line-height:1.75;color:#9DAEA4}
.faddr strong{display:block;color:#fff;font-family:var(--display);font-size:1rem;margin-bottom:.6rem;font-weight:700}
.faddr .motto-f{font-family:var(--deva);color:var(--gold-pure);font-size:.95rem;margin-bottom:.7rem}
.fsocial{display:flex;gap:.5rem;margin-top:1rem}
.fsocial a{
  width:2rem;height:2rem;border:1px solid rgba(255,255,255,.2);border-radius:4px;display:grid;place-items:center;
  transition:background .18s ease,border-color .18s ease,transform .18s ease;
}
.fsocial a::after{display:none}
.fsocial a:hover{background:var(--gold-pure);border-color:var(--gold-pure);color:#241a04;transform:translateY(-2px)}
.fbot{
  border-top:1px solid rgba(255,255,255,.12);padding-block:1rem;display:flex;justify-content:space-between;
  gap:1rem;flex-wrap:wrap;font-size:.78rem;color:#7E9187;
}
.fbot span{display:flex;align-items:center;gap:.4rem}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  .lf,.arc{stroke-dashoffset:0}
  .fig{opacity:1}
  .js .rv{opacity:1;transform:none}
}
</style>

<script>document.documentElement.classList.add("js");</script>

