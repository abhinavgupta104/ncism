<main id="main">

<div class="hero">
  <div class="wrap">
    <div>
      <span class="eyebrow">Established under the NCISM Act, 2020</span>
      <h1>Standards for Ayurveda, Unani, Siddha and&nbsp;Sowa-Rigpa.</h1>
      <div class="motto" lang="sa">।। आयुषे सर्वलोकानाम् ।।</div>
      <p class="motto-en">For the life and health of all people</p>
      <p class="lede">
        The Commission regulates medical education and practice across India's four recognised traditional
        systems — setting curricula, assessing institutions, and maintaining the national register.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#finder">
          Check a college's status
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost" href="#notices">Public notices</a>
      </div>
    </div>
    <div class="hero-art">
      <svg viewBox="0 0 300 300" role="img" aria-label="The NCISM emblem: four leaves rising from a central figure beneath a sun arc">
        <defs>
          <linearGradient id="h1g" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#B26412"/><stop offset="1" stop-color="#DEAC2F"/></linearGradient>
          <linearGradient id="h2g" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#DEAC2F"/><stop offset="1" stop-color="#F4CC75"/></linearGradient>
          <linearGradient id="h3g" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#48AC92"/><stop offset="1" stop-color="#3FA832"/></linearGradient>
          <linearGradient id="h4g" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#3FA832"/><stop offset="1" stop-color="#91B62A"/></linearGradient>
        </defs>
        <g transform="translate(150,268)">
          <path class="lf" stroke="url(#h1g)" transform="rotate(-58)" d="M0 0 C 46 -48 46 -116 0 -175 C -46 -116 -46 -48 0 0 Z"/>
          <path class="lf" stroke="url(#h2g)" transform="rotate(-26)" d="M0 0 C 46 -48 46 -116 0 -175 C -46 -116 -46 -48 0 0 Z"/>
          <path class="lf" stroke="url(#h3g)" transform="rotate(26)" d="M0 0 C 46 -48 46 -116 0 -175 C -46 -116 -46 -48 0 0 Z"/>
          <path class="lf" stroke="url(#h4g)" transform="rotate(58)" d="M0 0 C 46 -48 46 -116 0 -175 C -46 -116 -46 -48 0 0 Z"/>
        </g>
