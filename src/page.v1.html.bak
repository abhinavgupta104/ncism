    </div>
  </div>
</footer>

<script>
(function(){
  "use strict";
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- notices data ---------- */
  var NOTICES = {
    notices:[
      ['12 Aug 2026','Expression of Interest to conduct UG &amp; PG Electives','new'],
      ['06 Aug 2026','Amendment in Internship Completion for appearing in AIAPGET-2026','new'],
      ['28 Jul 2026','Submission of schemes to establish new colleges for A.Y. 2027-28','pdf'],
      ['19 Jul 2026','Constitution of the Internal Committee under the POSH Act, 2013','pdf'],
      ['04 Jul 2026','Establishment of new Ayurveda UG colleges with 60-seat intake','pdf'],
      ['21 Jun 2026','Revision of honorarium, TA/DA and accommodation for MARBISM experts','pdf'],
      ['09 Jun 2026','Implementation of Right to Practice of ISM practitioners','pdf']
    ],
    tenders:[
      ['10 Aug 2026','Supply and installation of network infrastructure at Dhanwantari Bhawan','new'],
      ['30 Jul 2026','Annual maintenance contract for office equipment 2026-27','pdf'],
      ['14 Jul 2026','Engagement of agency for digitisation of commission records','pdf'],
      ['02 Jul 2026','Housekeeping and security services — two-year contract','pdf'],
      ['15 Jun 2026','Corrigendum: extension of bid submission date for IT hardware','pdf']
    ],
    jobs:[
      ['08 Aug 2026','Walk-in interview: Young Professional / Consultant (IT)','new'],
      ['25 Jul 2026','Vacancies for various posts on deputation basis','pdf'],
      ['11 Jul 2026','Corrigendum to recruitment notice for Junior Technical Officer','pdf'],
      ['27 Jun 2026','Contractual vacancies for JTO and MTS in NCISM','pdf'],
      ['13 Jun 2026','Advertisement for vacancy in CPMU, Ministry of Ayush','pdf']
    ],
    results:[
      ['05 Aug 2026','Result for the posts of JTO and MTS in NCISM','ok'],
      ['22 Jul 2026','AACCC AIQ UG and PG counselling — final allotment','ok'],
      ['08 Jul 2026','National Ayurveda Dhanwantari Award 2026 — selected awardees','ok'],
      ['24 Jun 2026','Publication grant beneficiaries 2025-26','pdf'],
      ['10 Jun 2026','Affiliation of Ayurveda Gurukulams — approved list','pdf']
    ]
  };
  var CHIP = {new:'New', pdf:'PDF', ok:'Result'};

  function renderNotices(key){
    var rows = NOTICES[key] || [];
    document.getElementById('noticeList').innerHTML = rows.map(function(r){
      return '<li><a href="#notices"><span class="nd">'+r[0]+'</span>'+
             '<span class="nt">'+r[1]+'</span>'+
             '<span class="chip '+r[2]+'">'+CHIP[r[2]]+'</span></a></li>';
    }).join('');
  }
  renderNotices('notices');

  document.querySelectorAll('.tab').forEach(function(t){
    t.addEventListener('click', function(){
      document.querySelectorAll('.tab').forEach(function(x){ x.setAttribute('aria-selected','false'); });
      t.setAttribute('aria-selected','true');
      renderNotices(t.dataset.tab);
    });
  });

  /* ---------- college finder (illustrative sample data) ---------- */
  var COLLEGES = [
    ['State Ayurveda Medical College, Pune','Ayurveda','Maharashtra',100,'Permitted'],
    ['Government Ayurveda College, Thrissur','Ayurveda','Kerala',75,'Permitted'],
    ['Rajkiya Ayurvedic Mahavidyalaya, Varanasi','Ayurveda','Uttar Pradesh',60,'Conditional'],
    ['Shri Dhanwantari Ayurveda Sansthan, Jaipur','Ayurveda','Rajasthan',60,'Permitted'],
    ['Sanjivani Institute of Ayurveda, Nagpur','Ayurveda','Maharashtra',60,'Denied'],
    ['Vaidyaratnam Ayurveda College, Kozhikode','Ayurveda','Kerala',50,'Permitted'],
    ['Government Unani Medical College, Hyderabad','Unani','Telangana',60,'Permitted'],
    ['Tibbia Unani Institute, Lucknow','Unani','Uttar Pradesh',50,'Conditional'],
    ['State Unani Medical College, Bengaluru','Unani','Karnataka',60,'Permitted'],
    ['Hakim Ajmal Khan Unani College, Aligarh','Unani','Uttar Pradesh',40,'Denied'],
    ['Government Siddha Medical College, Palayamkottai','Siddha','Tamil Nadu',75,'Permitted'],
    ['Siddha Medical Institute, Chennai','Siddha','Tamil Nadu',60,'Permitted'],
    ['Agasthiyar Siddha College, Madurai','Siddha','Tamil Nadu',50,'Conditional'],
    ['Himalayan Sowa-Rigpa Institute, Leh','Sowa-Rigpa','Ladakh',30,'Permitted'],
    ['Central Institute of Sowa-Rigpa, Gangtok','Sowa-Rigpa','Sikkim',25,'Permitted'],
    ['Bodhi Sowa-Rigpa College, Dharamshala','Sowa-Rigpa','Himachal Pradesh',25,'Conditional'],
    ['Government Ayurveda College, Bhubaneswar','Ayurveda','Odisha',60,'Permitted'],
    ['Ayurveda Mahavidyalaya, Ahmedabad','Ayurveda','Gujarat',100,'Permitted'],
    ['Rural Ayurveda Institute, Patna','Ayurveda','Bihar',50,'Denied'],
    ['Government Unani College, Bhopal','Unani','Madhya Pradesh',50,'Permitted']
  ];

  var tbody=document.getElementById('ftbody'),
      fq=document.getElementById('fq'), fsys=document.getElementById('fsys'),
      fstate=document.getElementById('fstate'), fstatus=document.getElementById('fstatus'),
      fcount=document.getElementById('fcount');

  COLLEGES.map(function(c){return c[2];}).filter(function(v,i,a){return a.indexOf(v)===i;}).sort()
    .forEach(function(s){ var o=document.createElement('option'); o.textContent=s; fstate.appendChild(o); });

  function esc(s){ return String(s).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }

  function renderColleges(){
    var q=fq.value.trim().toLowerCase();
    var rows=COLLEGES.filter(function(c){
      if(q && c[0].toLowerCase().indexOf(q)<0 && c[2].toLowerCase().indexOf(q)<0) return false;
      if(fsys.value && c[1]!==fsys.value) return false;
      if(fstate.value && c[2]!==fstate.value) return false;
      if(fstatus.value && c[4]!==fstatus.value) return false;
      return true;
    });
    fcount.textContent = rows.length + ' of ' + COLLEGES.length + ' shown';
    tbody.innerHTML = rows.length
      ? rows.map(function(c){
          return '<tr><td>'+esc(c[0])+'</td><td>'+esc(c[1])+'</td><td>'+esc(c[2])+'</td>'+
                 '<td class="num">'+c[3]+'</td>'+
                 '<td><span class="st '+c[4].toLowerCase()+'">'+c[4]+'</span></td></tr>';
        }).join('')
      : '<tr><td colspan="5" class="tbl-empty">No institutions match those filters.</td></tr>';
  }
  [fq,fsys,fstate,fstatus].forEach(function(el){ el.addEventListener('input', renderColleges); });
  renderColleges();

  /* ---------- reveal + counters ---------- */
  function countUp(el){
    var to=+el.dataset.to, suf=el.dataset.suffix||'', dur=1500, start=null;
    if(reduce){ el.textContent=to+suf; return; }
    function step(ts){
      if(!start) start=ts;
      var p=Math.min((ts-start)/dur,1);
      el.textContent = Math.round(to*(1-Math.pow(1-p,3))) + (p===1?suf:'');
      if(p<1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(!e.isIntersecting) return;
        e.target.classList.add('in');
        e.target.querySelectorAll('.v[data-to]').forEach(countUp);
        io.unobserve(e.target);
      });
    },{threshold:.18, rootMargin:'0px 0px -40px 0px'});
    document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('in'); });
    document.querySelectorAll('.v[data-to]').forEach(countUp);
  }
  /* safety net: if the observer never fires (tall viewport, headless capture,
     restrictive environment), nothing should stay invisible */
  addEventListener('load', function(){
    setTimeout(function(){
      document.querySelectorAll('.rv:not(.in)').forEach(function(el){
        var r = el.getBoundingClientRect();
        if(r.top < innerHeight && r.bottom > 0){
          el.classList.add('in');
          el.querySelectorAll('.v[data-to]').forEach(countUp);
        }
      });
    }, 900);
  });

  /* ---------- nav ---------- */
  var navItems = document.querySelectorAll('.nav-list > li');
  navItems.forEach(function(li){
    var btn=li.querySelector('.nav-btn');
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      var wasOpen=li.classList.contains('open');
      navItems.forEach(function(o){ o.classList.remove('open'); });
      if(!wasOpen) li.classList.add('open');
    });
  });
  document.addEventListener('click', function(){ navItems.forEach(function(o){ o.classList.remove('open'); }); });
  document.addEventListener('keydown', function(e){
    if(e.key==='Escape') navItems.forEach(function(o){ o.classList.remove('open'); });
  });
  var navToggle=document.getElementById('navToggle'), nav=document.getElementById('nav');
  navToggle.addEventListener('click', function(e){
    e.stopPropagation();
    var open=nav.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', open?'true':'false');
  });

  /* ---------- ticker pause ---------- */
  var track=document.getElementById('tickerTrack'), pause=document.getElementById('tickerPause'), paused=false;
  pause.addEventListener('click', function(){
    paused=!paused;
    track.style.animationPlayState = paused?'paused':'running';
    pause.textContent = paused?'▶':'❚❚';
    pause.setAttribute('aria-label', paused?'Play the latest updates ticker':'Pause the latest updates ticker');
  });

  /* ---------- accessibility tools ---------- */
  var SIZES={small:'15px',normal:'16.5px',large:'18.5px'};
  document.querySelectorAll('.tool[data-font]').forEach(function(b){
    b.addEventListener('click', function(){
      document.body.style.fontSize = SIZES[b.dataset.font];
      document.querySelectorAll('.tool[data-font]').forEach(function(x){ x.setAttribute('aria-pressed','false'); });
      b.setAttribute('aria-pressed','true');
    });
  });

  var themeBtn=document.getElementById('themeBtn');
  function currentDark(){
    var t=document.documentElement.getAttribute('data-theme');
    if(t) return t==='dark';
    return matchMedia('(prefers-color-scheme: dark)').matches;
  }
  function paintThemeBtn(){
    var d=currentDark();
    themeBtn.textContent = d ? '☀ Light' : '◑ Dark';
    themeBtn.setAttribute('aria-label', d ? 'Switch to light theme' : 'Switch to dark theme');
  }
  themeBtn.addEventListener('click', function(){
    document.documentElement.setAttribute('data-theme', currentDark()?'light':'dark');
    paintThemeBtn();
  });
  paintThemeBtn();

  /* ---------- language toggle (demo) ---------- */
  var langBtn=document.getElementById('langBtn'), hindi=false;
  var HI={
    h1:'आयुर्वेद, यूनानी, सिद्ध और सोवा-रिग्पा के मानक।',
    lede:'आयोग भारत की चार मान्यता प्राप्त पारंपरिक चिकित्सा पद्धतियों में शिक्षा और अभ्यास का नियमन करता है।'
  };
  var EN={
    h1:document.querySelector('.hero h1').innerHTML,
    lede:document.querySelector('.hero .lede').textContent
  };
  langBtn.addEventListener('click', function(){
    hindi=!hindi;
    var h1=document.querySelector('.hero h1'), lede=document.querySelector('.hero .lede');
    h1.innerHTML = hindi?HI.h1:EN.h1;
    lede.textContent = hindi?HI.lede:EN.lede;
    h1.style.fontFamily = hindi?'var(--deva)':'';
    lede.style.fontFamily = hindi?'var(--deva)':'';
    document.documentElement.lang = hindi?'hi':'en';
  });
})();
</script>
