      <div class="stat glass rv"><div class="v" data-to="55" data-suffix="k+">55k+</div><div class="k">UG seats sanctioned</div></div>
      <div class="stat glass rv"><div class="v" data-to="2020">2020</div><div class="k">Act of Parliament</div></div>
    </div>
  </div>
</section>

</main>

